package commandline.interfaces

import std.collection.ArrayList
import std.collection.HashSet
import commandline.exceptions.NotImplementedException
import commandline.terminal.progressLogger

/**
 * 计算两个字符串的编辑距离（Levenshtein距离）
 * 
 * @param s1 第一个字符串
 * @param s2 第二个字符串
 * @return 编辑距离
 */
public func levenshteinDistance(s1: String, s2: String): Int {
    let len1 = s1.size
    let len2 = s2.size
    
    if (len1 == 0) { return len2 }
    if (len2 == 0) { return len1 }
    
    // 使用简化的一维数组实现
    var prevRow = Array<Int>(len2 + 1, repeat: 0)
    var currRow = Array<Int>(len2 + 1, repeat: 0)
    
    // 初始化第一行
    for (j in 0..(len2 + 1)) {
        prevRow[j] = j
    }
    
    // 填充矩阵
    for (i in 1..(len1 + 1)) {
        currRow[0] = i
        
        for (j in 1..(len2 + 1)) {
            let cost = if (s1[i - 1] == s2[j - 1]) { 0 } else { 1 }
            
            let deletion = prevRow[j] + 1
            let insertion = currRow[j - 1] + 1
            let substitution = prevRow[j - 1] + cost
            
            currRow[j] = min(deletion, insertion, [substitution])
        }
        
        // 交换行
        let temp = prevRow
        prevRow = currRow
        currRow = temp
    }
    
    return prevRow[len2]
}

/**
 * 计算字符串相似度（0-1之间，1表示完全相同）
 * 
 * @param s1 第一个字符串
 * @param s2 第二个字符串
 * @return 相似度分数
 */
public func similarity(s1: String, s2: String): Float64 {
    if (s1.isEmpty() && s2.isEmpty()) {
        return 1.0
    }
    
    let maxLen = max(s1.size, s2.size, [0])
    let distance = levenshteinDistance(s1, s2)
    
    return 1.0 - (Float64(distance) / Float64(maxLen))
}

/**
 * 检查字符串是否以指定前缀开始（忽略大小写）
 * 
 * @param str 要检查的字符串
 * @param prefix 前缀
 * @return 如果以前缀开始返回true
 */
public func startsWithIgnoreCase(str: String, prefix: String): Bool {
    let lowerStr = str.toAsciiLower()
    let lowerPrefix = prefix.toAsciiLower()
    return lowerStr.startsWith(lowerPrefix)
}


/**
 * CLI应用程序接口
 * 定义CLI应用程序的基本行为，提供默认的命令路由实现
 * 
 * 验证需求：9.2, 9.3
 */
public interface CLI {
    /**
     * 获取命令数组
     * 实现类需要提供命令列表
     */
    prop commands: Array<Command>
    
    /**
     * 获取命令行参数数组
     * 实现类需要提供参数列表
     */
    prop args: Array<String>
    
    /**
     * 应用程序名称
     * 默认值为 "My CLI Application"
     */
    prop name: String { get() { "My CLI Application" } }
    
    /**
     * 应用程序版本
     * 默认值为 "0.0.0"
     */
    prop version: String { get() { "0.0.0" } }
    
    /**
     * 应用程序描述
     * 默认值为 "No description"
     */
    prop description: String { get() { "No description" } }
    
    /**
     * 执行CLI应用程序
     * @CLIApp宏会生成具体的实现
     * 应用程序应该在内部处理所有输出，包括打印结果
     * @return 退出码，0表示成功，非0表示失败
     * @throws NotImplementedException 当方法未被@CLIApp宏实现时抛出
     */
    func execute(): Int {
        throw NotImplementedException("execute method should be generated by @CLIApp macro")
    }
    
    /**
     * 获取通用帮助信息
     * @CLIApp宏会生成具体的实现
     * @return 帮助信息字符串
     * @throws NotImplementedException 当方法未被@CLIApp宏实现时抛出
     */
    func getHelp(): String {
        throw NotImplementedException("getGeneralHelp method should be generated by @CLIApp macro")
    }
    
    /**
     * 获取特定命令的帮助信息
     * @CLIApp宏会生成具体的实现
     * @param commandName 命令名称
     * @return 命令帮助信息字符串
     * @throws NotImplementedException 当方法未被@CLIApp宏实现时抛出
     */
    func getHelp(_: String): String {
        throw NotImplementedException("getCommandHelp method should be generated by @CLIApp macro")
    }
    
    /**
     * 查找最相似的命令建议（从命令列表）
     * 
     * @param input 用户输入的命令
     * @param commands 可用命令列表
     * @param maxSuggestions 最大建议数量
     * @param minSimilarity 最小相似度阈值
     * @return 建议的命令列表
     */
    static func findSimilarCommands(
        input: String, 
        commands: Array<Command>, 
        maxSuggestions: Int,
        minSimilarity: Float64
    ): Array<String> {
        // 计算所有命令的相似度，并创建(命令名, 相似度)的tuple数组
        let commandScores = commands.map({command: Command =>
            let commandName = command.commandName
            var sim = similarity(input.toAsciiLower(), commandName.toAsciiLower())
            
            // 如果以相同前缀开始，给予额外加分
            if (startsWithIgnoreCase(commandName, input)) {
                sim = sim + 0.2
            }
            
            (commandName, sim)
        })
        
        // 过滤出相似度达到阈值的命令
        let filteredCommands = commandScores.filter({item: (String, Float64) => item[1] >= minSimilarity})
        
        // 转换为ArrayList进行排序
        var suggestions = ArrayList<(String, Float64)>()
        for (item in filteredCommands) {
            suggestions.add(item)
        }
        
        // 按相似度降序排序
        let suggestionArray = suggestions.toArray()
        for (i in 0..suggestionArray.size) {
            for (j in 0..(suggestionArray.size - i - 1)) {
                if (suggestionArray[j][1] < suggestionArray[j + 1][1]) {
                    let temp = suggestionArray[j]
                    suggestionArray[j] = suggestionArray[j + 1]
                    suggestionArray[j + 1] = temp
                }
            }
        }
        
        // 取前N个建议，并提取命令名
        let resultSize = min(suggestionArray.size, maxSuggestions, [0])
        var result = ArrayList<String>()
        
        for (i in 0..resultSize) {
            result.add(suggestionArray[i][0])
        }
        
        return result.toArray()
    }
    
    /**
     * 查找最相似的命令建议（使用默认参数）
     */
    static func findSimilarCommands(
        input: String, 
        commands: Array<Command>
    ): Array<String> {
        return findSimilarCommands(input, commands, 3, 0.3)
    }

    static func uniqueStrings(values: Array<String>): Array<String> {
        let result = ArrayList<String>()
        let seen = HashSet<String>()
        for (value in values) {
            if (!seen.contains(value)) {
                seen.add(value)
                result.add(value)
            }
        }
        return result.toArray()
    }

    static func printUnknownCommand(commandName: String, commands: Array<Command>): Unit {
        let suggestions = findSimilarCommands(commandName, commands)
        progressLogger.printError("Unknown command '${commandName}'")
        if (suggestions.size > 0) {
            progressLogger.log("")
            progressLogger.printInfo("Did you mean:")
            for (suggestion in suggestions) {
                progressLogger.log("  ${suggestion}")
            }
        }
        progressLogger.log("")
        progressLogger.log("Use 'help' to see all available commands")
    }

    static func printMissingCommand(): Unit {
        progressLogger.printError("Please specify a command")
        progressLogger.log("Use 'help' to see available commands")
    }
    
    /**
     * 查找最相似的选项建议
     * 
     * @param input 用户输入的选项
     * @param validOptions 有效选项列表
     * @param maxSuggestions 最大建议数量
     * @param minSimilarity 最小相似度阈值
     * @return 建议的选项列表
     */
    static func findSimilarOptions(
        input: String, 
        validOptions: Array<String>, 
        maxSuggestions: Int,
        minSimilarity: Float64
    ): Array<String> {
        // 计算所有选项的相似度，并创建(选项名, 相似度)的tuple数组
        let optionScores = validOptions.map({option: String =>
            var sim = similarity(input.toAsciiLower(), option.toAsciiLower())
            
            // 如果以相同前缀开始，给予额外加分
            if (startsWithIgnoreCase(option, input)) {
                sim = sim + 0.2
            }
            
            (option, sim)
        })
        
        // 过滤出相似度达到阈值的选项
        let filteredOptions = optionScores.filter({item: (String, Float64) => item[1] >= minSimilarity})
        
        // 转换为ArrayList进行排序
        var suggestions = ArrayList<(String, Float64)>()
        for (item in filteredOptions) {
            suggestions.add(item)
        }
        
        // 按相似度降序排序
        let suggestionArray = suggestions.toArray()
        for (i in 0..suggestionArray.size) {
            for (j in 0..(suggestionArray.size - i - 1)) {
                if (suggestionArray[j][1] < suggestionArray[j + 1][1]) {
                    let temp = suggestionArray[j]
                    suggestionArray[j] = suggestionArray[j + 1]
                    suggestionArray[j + 1] = temp
                }
            }
        }
        
        // 取前N个建议，并提取选项名
        let resultSize = min(suggestionArray.size, maxSuggestions, [0])
        var result = ArrayList<String>()
        
        for (i in 0..resultSize) {
            result.add(suggestionArray[i][0])
        }
        
        return result.toArray()
    }
    
    /**
     * 查找最相似的选项建议（使用默认参数）
     */
    static func findSimilarOptions(
        input: String, 
        validOptions: Array<String>
    ): Array<String> {
        return findSimilarOptions(input, validOptions, 3, 0.3)
    }

    static func printUnknownOptions(commandName: String, invalidOptions: Array<String>, validOptions: Array<String>): Unit {
        let uniqueInvalidOptions = uniqueStrings(invalidOptions)
        for (invalidOption in uniqueInvalidOptions) {
            progressLogger.printError("Unknown option '${invalidOption}'")
            let suggestions = findSimilarOptions(invalidOption, validOptions)
            if (suggestions.size > 0) {
                progressLogger.printInfo("Did you mean:")
                for (suggestion in suggestions) {
                    progressLogger.log("  ${suggestion}")
                }
            }
        }
        progressLogger.log("Use '${commandName} --help' to see available options")
    }

    static func printMissingRequiredOption(fieldName: String): Unit {
        progressLogger.printError("Required option '${fieldName}' is missing")
        progressLogger.log("Use 'markit help' to see available commands and options.")
    }
}
