{
  "title": "Markit Typst Example",
  "i18n": {
    "default": "zh",
    "target": "zh"
  },
  "theme": "arctic",
  "format": "website",
  "codeBlock": {
    "group": false
  },
  "table": {
    "threeLine": true
  },
  "toc": true,
  "heading": {
    "closable": false,
    "number": {
      "enabled": true,
      "resetFor": "directory",
      "startFrom": [
        1,
        1,
        1,
        1,
        1,
        1
      ]
    }
  },
  "summary": [
    {
      "home": true,
      "label": "首页"
    },
    {
      "file": "markit.md",
      "showDrafts": true,
      "label": "文档"
    }
  ],
  "website": {
    "chapter": {
      "navigation": true,
      "prevText": "上一章",
      "nextText": "下一章"
    },
    "statistic": {
      "totalTexts": true,
      "totalTextsTemplate": "本文共 {total} 字",
      "spentTime": true,
      "spentTimeTemplate": "预计耗时 {total}{unit}",
      "second": "秒",
      "minute": "分钟"
    }
  }
}
